#!/usr/bin/env bash
set -euo pipefail

### CONFIG ###
STATE_DIR="$HOME/.config/timed-youtube-blocker"
STATE_FILE="$STATE_DIR/state"
HOSTS_FILE="/etc/hosts"

### /etc/hosts blocking part ###
BEGIN_MARK="# BEGIN YOUTUBE BLOCK"
END_MARK="# END YOUTUBE BLOCK"

BLOCK_LINES=$(cat <<'EOF'
0.0.0.0 youtube.com
0.0.0.0 www.youtube.com
0.0.0.0 m.youtube.com
0.0.0.0 youtu.be
0.0.0.0 googlevideo.com
0.0.0.0 ytimg.com
EOF
)

### INPUT ###
if [[ $# -ne 1 ]] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
  echo "Usage: allow-youtube <minutes>"
  exit 1
fi

MINUTES="$1"
mkdir -p "$STATE_DIR"

now=$(date +%s)

### LOAD STATE ###
status="blocked"
expires_at=0
cooldown_until=0

if [[ -f "$STATE_FILE" ]]; then
  source "$STATE_FILE"
fi

### CHECK COOLDOWN OR ALREADY ALLOWED ###
if [[ "$status" == "allowed" ]]; then
  echo "YouTube is already allowed until $(date -d "@$expires_at")"
  exit 1
fi

if (( now < cooldown_until )); then
  wait=$(( (cooldown_until - now) / 60 ))
  echo "Cooldown active. Try again in $wait minute(s)."
  exit 1
fi

### UPDATE STATE ###
expires_at=$(( now + MINUTES*60 ))
status="allowed"
cooldown_until=0

# Atomic write
tmp=$(mktemp)
cat > "$tmp" <<EOF
status=$status
expires_at=$expires_at
cooldown_until=$cooldown_until
EOF
mv "$tmp" "$STATE_FILE"

### UNBLOCK HOSTS ###
sudo sed -i "/$BEGIN_MARK/,/$END_MARK/d" "$HOSTS_FILE"

### SCHEDULE RE-BLOCK ###
systemd-run \
  --unit=reblock-youtube \
  --on-active="${MINUTES}m" \
  --quiet \
  sudo /usr/local/bin/block-youtube

echo "YouTube is now allowed for $MINUTES minutes."
